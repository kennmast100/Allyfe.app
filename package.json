{
  "name": "allyfe",
  "private": true,
  "version": "0.1.0",
  "description": "Allyfe connects clients with verified artisans. Skilled People \u2022 Real Work \u2022 Brighter Lives.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run build && node dist-server/index.mjs",
    "build": "tsc -b && vite build && esbuild server/index.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist-server/index.mjs",
    "start": "node dist-server/index.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
